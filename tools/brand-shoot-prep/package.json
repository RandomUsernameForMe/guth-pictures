{
  "name": "brand-shoot-prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code tool to prep brand photo shoots: research a client, design shoot concepts, build moodboard + pose board, assemble a Canva presentation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch-images": "node scripts/fetch-images.mjs",
    "build-board": "node scripts/build-board.mjs",
    "gen-images": "node scripts/gen-images.mjs",
    "build-page": "node scripts/build-page.mjs",
    "build-index": "node scripts/build-index.mjs",
    "review": "node scripts/review-server.mjs --open",
    "codes": "node scripts/codes.mjs",
    "build-share": "node scripts/build-share.mjs",
    "build-proposal-json": "node scripts/build-proposal-json.mjs",
    "sync": "node scripts/sync-to-web.mjs"
  }
}
