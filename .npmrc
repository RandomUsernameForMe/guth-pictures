# @vercel/speed-insights@2 declares an OPTIONAL @sveltejs/kit peer that drags a vite@8-beta peer,
# conflicting with the project's vite@6 (vitest / @vitejs/plugin-react). We don't use Svelte, so the
# conflict is spurious. legacy-peer-deps keeps `npm install` (local + Vercel build) from failing on it.
legacy-peer-deps=true
