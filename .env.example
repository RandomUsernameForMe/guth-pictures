# Admin auth — generate hash with: node -e "require('bcrypt').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=

# NextAuth / iron-session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Formspree contact form (https://formspree.io)
FORMSPREE_FORM_ID=
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Vercel KV (Upstash Redis) — copy from Vercel dashboard
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# Site URL — set to your production domain
NEXT_PUBLIC_SITE_URL=https://guthpictures.eu

# Contact email shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=jan@guthpictures.cz

# Adobe Lightroom OAuth (optional)
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_REDIRECT_URI=https://guthpictures.eu/api/admin/lightroom/callback
